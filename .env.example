# Copy to .env and fill in. Never commit .env — it is gitignored.

# Postgres connection string
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/workshop_collective

# Session signing secret (any long random string)
JWT_SECRET=

# Manus OAuth (sign-in requires the deployed platform; blank locally)
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Configurable CMS route prefix (e.g. /studio, /workspace, /portal)
VITE_CMS_PATH=/studio

# Canonical origin used for canonical/OG URLs, robots.txt and sitemap.xml.
# Blank locally falls back to the requesting host. Blank in production falls back
# to https://ruang-karya.co.id. Set it explicitly to override either.
SITE_URL=

# Object storage for CMS image uploads. Without these the server falls back to
# a local directory, which is fine for development but not for production.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
